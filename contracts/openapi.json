  "components": {
    "schemas": {
      "CopilotAnswer": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "facts_used": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Facts Used"
          },
          "template_fallback": {
            "type": "boolean",
            "title": "Template Fallback"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "default": "Numbers are rendered by code from the maps, not generated by the language model."
          }
        },
        "type": "object",
        "required": [
          "answer",
          "facts_used",
          "template_fallback"
        ],
        "title": "CopilotAnswer"
      },
      "CopilotQuestion": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "lang": {
            "type": "string",
            "title": "Lang",
            "description": "'en' or 'ne'",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "question"
        ],
        "title": "CopilotQuestion"
      },
      "CutoffSettlementRecord": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Settlement name from OSM place/town tag"
          },
          "class": {
            "$ref": "#/components/schemas/SettlementClass",
            "description": "Cut-off classification"
          },
          "buildings_affected": {
            "type": "integer",
            "title": "Buildings Affected",
            "description": "Number of flooded/affected buildings in cluster"
          },
          "extra_distance_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extra Distance Km",
            "description": "Detour km if still connected, null if cut off"
          },
          "priority_rank": {
            "type": "integer",
            "title": "Priority Rank",
            "description": "Rescue priority rank (1 = highest priority)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "class",
          "buildings_affected",
          "priority_rank"
        ],
        "title": "CutoffSettlementRecord",
        "description": "Entry in cutoff_settlements table."
      },
      "DegradationItem": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Machine-readable degradation code"
          },
          "reason_key": {
            "type": "string",
            "title": "Reason Key",
            "description": "i18n catalogue key explaining degradation"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details",
            "description": "Additional context"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "reason_key"
        ],
        "title": "DegradationItem",
        "description": "Disclosed degradation entry."
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "AOI_TOO_LARGE",
          "NO_VALID_ORBIT_PAIR",
          "NO_POST_EVENT_SCENE",
          "CDSE_UNAVAILABLE",
          "OHSOME_UNAVAILABLE",
          "MODEL_LOW_CONFIDENCE",
          "S2_TOO_CLOUDY",
          "BUSY",
          "INTERNAL"
        ],
        "title": "ErrorCode",
        "description": "Canonical error codes defined in ARCHITECTURE.md."
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Machine-readable error code"
          },
          "message_key": {
            "type": "string",
            "title": "Message Key",
            "description": "Key for i18n message catalogue"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params",
            "description": "Template parameters for translation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message_key"
        ],
        "title": "ErrorDetail",
        "description": "Structured error payload carrying locale message_key and parameter dict."
      },
      "FactItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Machine-readable fact key e.g. flooded_area_km2"
          },
          "value": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ],
            "title": "Value",
            "description": "Fact value computed by pipeline"
          },
          "unit": {
            "type": "string",
            "title": "Unit",
            "description": "Unit of measurement e.g. km2, count, km"
          },
          "source_stage": {
            "$ref": "#/components/schemas/PipelineStage",
            "description": "Pipeline stage producing this fact"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "value",
          "unit",
          "source_stage"
        ],
        "title": "FactItem",
        "description": "An individual atomic fact item."
      },
      "FactsJSON": {
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/FactsMeta"
          },
          "facts": {
            "items": {
              "$ref": "#/components/schemas/FactItem"
            },
            "type": "array",
            "title": "Facts"
          },
          "tables": {
            "$ref": "#/components/schemas/FactsTables"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "meta",
          "facts",
          "tables"
        ],
        "title": "FactsJSON",
        "description": "Single source of truth numbers generated by Stage 8 (Facts)."
      },
      "FactsMeta": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "bbox": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bbox"
          },
          "event_date": {
            "type": "string",
            "title": "Event Date"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "units": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Units"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "bbox",
          "event_date",
          "provenance"
        ],
        "title": "FactsMeta",
        "description": "Metadata enclosing facts.json."
      },
      "FactsTables": {
        "properties": {
          "cutoff_settlements": {
            "items": {
              "$ref": "#/components/schemas/CutoffSettlementRecord"
            },
            "type": "array",
            "title": "Cutoff Settlements"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "FactsTables",
        "description": "Structured tabular data in facts.json."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Liveness state",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "App version",
            "default": "0.1.0"
          },
          "mock_mode": {
            "type": "boolean",
            "title": "Mock Mode",
            "description": "Whether server is operating in mock mode",
            "default": false
          },
          "onnx_available": {
            "type": "boolean",
            "title": "Onnx Available",
            "description": "Whether ONNX runtime is available for inference",
            "default": true
          },
          "torch_detected": {
            "type": "boolean",
            "title": "Torch Detected",
            "description": "Compliance check: MUST be False in production",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "HealthResponse",
        "description": "System liveness and component status."
      },
      "JobOptions": {
        "properties": {
          "use_baseline": {
            "type": "boolean",
            "title": "Use Baseline",
            "description": "Force log-ratio baseline instead of ML model",
            "default": false
          },
          "optical_enabled": {
            "type": "boolean",
            "title": "Optical Enabled",
            "description": "Attempt Sentinel-2 optical cue extraction",
            "default": true
          },
          "max_pre_scenes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Pre Scenes",
            "description": "Max pre-event acquisitions to median"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "JobOptions",
        "description": "Optional execution tunables for a job."
      },
